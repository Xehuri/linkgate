<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则（dataExtractionRules）。
  与 backup_rules.xml 保持同样的排除列表：
  Cookie 快照（明文凭据）、密码库（Keystore 密钥不可迁移）、favicon 缓存都不进备份与换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="linkgate_cookies.xml" />
        <exclude domain="sharedpref" path="linkgate_passwords.xml" />
        <exclude domain="file" path="site_icons" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="linkgate_cookies.xml" />
        <exclude domain="sharedpref" path="linkgate_passwords.xml" />
        <exclude domain="file" path="site_icons" />
    </device-transfer>
</data-extraction-rules>
